<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/workout_builder_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/workout_builder_duration_label" />

        <EditText
            android:id="@+id/et_duration_minutes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/workout_builder_duration_hint"
            android:inputType="number" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/workout_builder_muscle_label" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2">

            <CheckBox
                android:id="@+id/cb_muscle_chest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/muscle_chest" />

            <CheckBox
                android:id="@+id/cb_muscle_legs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/muscle_legs" />

            <CheckBox
                android:id="@+id/cb_muscle_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/muscle_back" />

            <CheckBox
                android:id="@+id/cb_muscle_shoulders"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/muscle_shoulders" />

            <CheckBox
                android:id="@+id/cb_muscle_biceps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/muscle_biceps" />

            <CheckBox
                android:id="@+id/cb_muscle_triceps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/muscle_triceps" />
        </GridLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/workout_builder_equipment_label" />

        <CheckBox
            android:id="@+id/cb_equipment_bodyweight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/equipment_bodyweight" />

        <CheckBox
            android:id="@+id/cb_equipment_dumbbells"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/equipment_dumbbells" />

        <CheckBox
            android:id="@+id/cb_equipment_barbell"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/equipment_barbell" />

        <Button
            android:id="@+id/btn_generate_workout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/workout_builder_generate_button" />

        <LinearLayout
            android:id="@+id/preview_action_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/btn_start_workout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/workout_builder_start_button" />

            <Button
                android:id="@+id/btn_regenerate_workout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/workout_builder_regenerate_button" />

            <Button
                android:id="@+id/btn_edit_constraints"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/workout_builder_edit_button" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_builder_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <TextView
            android:id="@+id/tv_builder_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="?attr/textAppearanceBodyMedium" />
    </LinearLayout>
</ScrollView>
