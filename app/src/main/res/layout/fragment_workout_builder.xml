<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 1. Build Method -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/workout_builder_mode_label"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rg_build_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb_mode_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="@string/workout_builder_mode_count" />

            <RadioButton
                android:id="@+id/rb_mode_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/workout_builder_mode_time" />
        </RadioGroup>

        <!-- 2. Mode-Specific Inputs -->
        <LinearLayout
            android:id="@+id/container_mode_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/workout_builder_exercise_count_label" />

            <EditText
                android:id="@+id/et_exercise_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/workout_builder_exercise_count_hint"
                android:inputType="number" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/container_mode_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/workout_builder_time_label" />

            <EditText
                android:id="@+id/et_target_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/workout_builder_time_hint"
                android:inputType="number" />
        </LinearLayout>

        <!-- 3. Global Intensity Settings -->
        <Button
            android:id="@+id/btn_intensity_toggle"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="▼ Intensity &amp; Intervals"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/container_intensity_dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <RadioGroup
                android:id="@+id/rg_intensity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rb_intensity_low"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/workout_builder_intensity_low" />

                <RadioButton
                    android:id="@+id/rb_intensity_mod"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/workout_builder_intensity_mod" />

                <RadioButton
                    android:id="@+id/rb_intensity_hiit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/workout_builder_intensity_hiit" />

                <RadioButton
                    android:id="@+id/rb_intensity_custom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/workout_builder_intensity_custom" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/container_custom_intervals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <EditText
                    android:id="@+id/et_custom_work"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Work (s)"
                    android:inputType="number" />

                <EditText
                    android:id="@+id/et_custom_rest"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:hint="Rest (s)"
                    android:inputType="number" />
            </LinearLayout>
        </LinearLayout>

        <!-- 4. Muscle Groups -->
        <Button
            android:id="@+id/btn_muscle_toggle"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="▼ Muscle Groups"
            android:textStyle="bold" />

        <GridLayout
            android:id="@+id/container_muscle_dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:visibility="gone">

            <CheckBox
                android:id="@+id/cb_muscle_chest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/muscle_chest" />

            <CheckBox
                android:id="@+id/cb_muscle_legs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/muscle_legs" />

            <CheckBox
                android:id="@+id/cb_muscle_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/muscle_back" />

            <CheckBox
                android:id="@+id/cb_muscle_shoulders"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/muscle_shoulders" />

            <CheckBox
                android:id="@+id/cb_muscle_biceps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/muscle_biceps" />

            <CheckBox
                android:id="@+id/cb_muscle_triceps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/muscle_triceps" />
        </GridLayout>

        <!-- 5. Equipment -->
        <Button
            android:id="@+id/btn_equipment_toggle"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="▼ Equipment"
            android:textStyle="bold" />

        <GridLayout
            android:id="@+id/container_equipment_dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:visibility="gone">

            <CheckBox
                android:id="@+id/cb_equipment_bodyweight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/equipment_bodyweight" />

            <CheckBox
                android:id="@+id/cb_equipment_dumbbells"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/equipment_dumbbells" />

            <CheckBox
                android:id="@+id/cb_equipment_barbell"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/equipment_barbell" />

            <CheckBox
                android:id="@+id/cb_equipment_ez_curl_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/equipment_ez_curl_bar" />

            <CheckBox
                android:id="@+id/cb_equipment_machine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/equipment_machine" />

            <CheckBox
                android:id="@+id/cb_equipment_cable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/equipment_cable" />
        </GridLayout>

        <Button
            android:id="@+id/btn_generate_workout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/workout_builder_generate_button" />

    </LinearLayout>
</ScrollView>
